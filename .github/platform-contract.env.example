# Variables of the protected `agent` GitHub Environment.
#
# PLATFORM CONTRACT: copy these from the foundation repo's published contract
# (artifact platform-contract-<env>, file foundry-<env>.json, key "values") with
#   ./scripts/bootstrap-github-oidc.ps1 -ContractFile <path-to-foundry-<env>.json>
# Never populate them from foundation Terraform state: this repo has no access to it.
AZURE_TENANT_ID=<tenant-id>
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_RESOURCE_GROUP=<resource-group>
FOUNDRY_ACCOUNT_NAME=<account>
FOUNDRY_PROJECT_NAME=<project>
FOUNDRY_PROJECT_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
JFROG_REGISTRY_CONNECTION_NAME=<connection>
JF_URL=https://<registry-host>
JFROG_REPO=<repository-key>
JFROG_GITHUB_OIDC_PROVIDER=<github-oidc-provider-name>
# Also in the contract; present for reference and the generated asset inventory:
#   FOUNDRY_PROJECT_PRINCIPAL_ID, JFROG_REGISTRY_CONNECTION_ID,
#   REGISTRY_TOKEN_AUDIENCE, REGISTRY_TOKEN_ENDPOINT, REGISTRY_OIDC_PROVIDER_NAME

# APP-OWNED: set by this repo's bootstrap script or by hand, not part of the contract.
AGENT_AZURE_CLIENT_ID=<agent-deployer-app-client-id>
AGENT_STATE_RESOURCE_GROUP=<state-resource-group>
AGENT_STATE_STORAGE_ACCOUNT=<state-storage-account>
AGENT_STATE_CONTAINER=agent-tfstate
AGENT_STATE_KEY=hosted-agent/<environment>.tfstate
MODEL_DEPLOYMENT_NAME=<model-deployment>
SUPPORTED_AGENT_SKUS=0.5:1Gi,1:2Gi,2:4Gi
RAI_POLICY_ID=<optional-rai-policy-resource-id>
AGENT_CPU=0.5
AGENT_MEMORY=1Gi
TERRAFORM_VERSION=1.9.8
RUNNER_LABEL=byor-private
