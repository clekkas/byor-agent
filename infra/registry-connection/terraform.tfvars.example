# Copy to terraform.tfvars and fill in. None of these values are secrets:
# the audience is an Entra app ID and the registry issues short-lived tokens via OIDC.

subscription_id      = "<subscription-id>"
tenant_id            = "<tenant-id>"
resource_group_name  = "<resource-group>"
foundry_account_name = "<foundry-account-name>"
foundry_project_name = "<foundry-project-name>"

connection_name    = "private-registry" # must match registryConnectionId in azure.yaml
registry_target    = "https://yourtrial.jfrog.io"
token_audience     = "<entra-app-client-id>"
token_endpoint     = "/access/api/v1/oidc/token"
oidc_provider_name = "<jfrog-oidc-provider-name>"

# Set to true once if the connection was already created (e.g. with azd ai connection create).
import_existing_connection = false
